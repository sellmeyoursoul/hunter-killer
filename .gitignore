# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Godot Git Plugin (GDExtension binaries from official release)
!addons/godot-git-plugin/windows/*.dll
!addons/godot-git-plugin/linux/*.so
!addons/godot-git-plugin/macos/*.dylib

# Godot Git Plugin temp/backup DLLs (Windows lock artifacts)
addons/godot-git-plugin/**/~*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Godot 4+ specific ignores
.godot/
/android/

# LLM specific ignores
inference/windows/bin/
modules/
*.gguf

# Randomized Playfield Spawn: overwritten every run, not meant to be committed itself — copy
# aside to spawn_layout_locked_*.json (tracked) to freeze a specific repro layout.
/spawn_layout_last_run.json
